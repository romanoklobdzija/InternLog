<?xml version="1.0" encoding="utf-8"?>

<Page
    x:Class="InternLog.Pages.DailyLogPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#F5F6F8">

    <Page.Resources>

        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="White"/>
        <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#111827"/>
        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="White"/>
        <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#111827"/>
        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#D1D5DB"/>
        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#2563EB"/>

        <Style x:Key="DailyLogTextBoxStyle" TargetType="TextBox">
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12"/>
        </Style>

    </Page.Resources>

    <ScrollViewer x:Name="MainScrollViewer">

        <Grid Padding="40">

            <StackPanel Spacing="28">

                <!-- HEADER -->

                <StackPanel Spacing="6">

                    <TextBlock
                        Text="Daily Log"
                        FontSize="32"
                        FontWeight="Bold"
                        Foreground="#111827"/>

                    <TextBlock
                        Text="Record your internship activities and keep track of your progress."
                        FontSize="15"
                        Foreground="#6B7280"/>

                </StackPanel>


                <!-- INTERNSHIP SELECTOR -->

                <StackPanel Spacing="14">

                    <TextBlock
                        Text="SELECT INTERNSHIP"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="#6B7280"/>

                    <Grid x:Name="InternshipsGrid">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                    </Grid>

                </StackPanel>


                <!-- DAILY LOG FORM -->

                <Border
                    Background="White"
                    CornerRadius="16"
                    Padding="28">

                    <StackPanel Spacing="22">

                        <!-- LOG HEADER -->

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Spacing="4">

                                <TextBlock
                                    x:Name="DayNumberText"
                                    Text="Day 1"
                                    FontSize="24"
                                    FontWeight="SemiBold"
                                    Foreground="#111827"/>

                                <TextBlock
                                    x:Name="DateText"
                                    Text="August 18, 2026"
                                    FontSize="14"
                                    Foreground="#6B7280"/>

                            </StackPanel>

                            <Border
                                Grid.Column="1"
                                Background="#EFF6FF"
                                CornerRadius="8"
                                Padding="12,8">

                                <TextBlock
                                    x:Name="SelectedInternshipText"
                                    Text="No internship selected"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Foreground="#2563EB"/>

                            </Border>

                        </Grid>


                        <!-- DESCRIPTION -->

                        <StackPanel Spacing="8">

                            <TextBlock
                                Text="What did you work on today?"
                                FontSize="15"
                                FontWeight="SemiBold"
                                Foreground="#111827"/>

                            <TextBox
                                x:Name="DescriptionTextBox"
                                Style="{StaticResource DailyLogTextBoxStyle}"
                                PlaceholderText="Describe what you worked on, what tasks you completed, and what you accomplished today..."
                                AcceptsReturn="True"
                                TextWrapping="Wrap"
                                MinHeight="180"/>

                        </StackPanel>


                        <!-- WORKING HOURS -->

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel
                                Grid.Column="0"
                                Spacing="8">

                                <TextBlock
                                    Text="Start time"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="#374151"/>

                                <TimePicker
                                    x:Name="StartTimePicker"
                                    ClockIdentifier="24HourClock"
                                    Foreground="#111827"
                                    Background="White"
                                    BorderBrush="#D1D5DB"
                                    BorderThickness="1"
                                    HorizontalAlignment="Stretch"/>

                            </StackPanel>

                            <StackPanel
                                Grid.Column="2"
                                Spacing="8">

                                <TextBlock
                                    Text="End time"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="#374151"/>

                                <TimePicker
                                    x:Name="EndTimePicker"
                                    ClockIdentifier="24HourClock"
                                    Foreground="#111827"
                                    Background="White"
                                    BorderBrush="#D1D5DB"
                                    BorderThickness="1"
                                    HorizontalAlignment="Stretch"/>

                            </StackPanel>

                        </Grid>


                        <!-- TASKS -->

                        <StackPanel Spacing="8">

                            <TextBlock
                                Text="Tasks completed"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Foreground="#374151"/>

                            <TextBox
                                x:Name="TasksTextBox"
                                Style="{StaticResource DailyLogTextBoxStyle}"
                                PlaceholderText="e.g. Database integration, testing..."
                                Height="42"/>

                        </StackPanel>


                        <!-- LEARNING -->

                        <StackPanel Spacing="8">

                            <TextBlock
                                Text="What did you learn?"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Foreground="#374151"/>

                            <TextBox
                                x:Name="LearningTextBox"
                                Style="{StaticResource DailyLogTextBoxStyle}"
                                PlaceholderText="Describe something new you learned today..."
                                AcceptsReturn="True"
                                TextWrapping="Wrap"
                                MinHeight="110"/>

                        </StackPanel>


                        <!-- NOTES -->

                        <StackPanel Spacing="8">

                            <TextBlock
                                Text="Additional notes"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Foreground="#374151"/>

                            <TextBox
                                x:Name="NotesTextBox"
                                Style="{StaticResource DailyLogTextBoxStyle}"
                                PlaceholderText="Optional notes..."
                                AcceptsReturn="True"
                                TextWrapping="Wrap"
                                MinHeight="90"/>

                        </StackPanel>


                        <!-- SAVE / UPDATE -->

                        <Button
                            x:Name="SaveLogButton"
                            Content="Save daily log"
                            Click="SaveLogButton_Click"
                            HorizontalAlignment="Right"
                            Padding="24,12"
                            Background="#2563EB"
                            Foreground="White"
                            BorderThickness="0"/>

                    </StackPanel>

                </Border>


                <!-- PREVIOUS ENTRIES -->

                <StackPanel Spacing="14">

                    <TextBlock
                        Text="YOUR DAILY LOG"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="#6B7280"/>

                    <ItemsControl
                        x:Name="DailyLogsItemsControl"/>

                </StackPanel>

            </StackPanel>

        </Grid>

    </ScrollViewer>

</Page>