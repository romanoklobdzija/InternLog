<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="InternLog.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{ThemeResource AppBackgroundBrush}">
        <ScrollViewer
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">

            <StackPanel
                Margin="40"
                Spacing="24">

                <StackPanel Spacing="6">
                    <TextBlock
                        x:Name="DashboardTitleText"
                        FontSize="32"
                        FontWeight="Bold"
                        Foreground="{ThemeResource PrimaryTextBrush}"/>

                    <TextBlock
                        x:Name="DashboardDescriptionText"
                        FontSize="16"
                        Foreground="{ThemeResource SecondaryTextBrush}"/>
                </StackPanel>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border
                        Grid.Column="0"
                        Background="{ThemeResource CardBackgroundBrush}"
                        CornerRadius="12"
                        Padding="20"
                        Margin="0,0,8,0">

                        <StackPanel Spacing="6">
                            <TextBlock
                                x:Name="ActiveInternshipsTitleText"
                                FontSize="14"
                                Foreground="{ThemeResource SecondaryTextBrush}"/>

                            <TextBlock
                                x:Name="ActiveInternshipsText"
                                FontSize="30"
                                FontWeight="Bold"
                                Foreground="{ThemeResource PrimaryTextBrush}"/>
                        </StackPanel>
                    </Border>

                    <Border
                        Grid.Column="1"
                        Background="{ThemeResource CardBackgroundBrush}"
                        CornerRadius="12"
                        Padding="20"
                        Margin="8,0">

                        <StackPanel Spacing="6">
                            <TextBlock
                                x:Name="DailyLogsTitleText"
                                FontSize="14"
                                Foreground="{ThemeResource SecondaryTextBrush}"/>

                            <TextBlock
                                x:Name="DailyLogsText"
                                FontSize="30"
                                FontWeight="Bold"
                                Foreground="{ThemeResource PrimaryTextBrush}"/>
                        </StackPanel>
                    </Border>

                    <Border
                        Grid.Column="2"
                        Background="{ThemeResource CardBackgroundBrush}"
                        CornerRadius="12"
                        Padding="20"
                        Margin="8,0">

                        <StackPanel Spacing="6">
                            <TextBlock
                                x:Name="PendingReviewTitleText"
                                FontSize="14"
                                Foreground="{ThemeResource SecondaryTextBrush}"/>

                            <TextBlock
                                x:Name="PendingReviewText"
                                FontSize="30"
                                FontWeight="Bold"
                                Foreground="{ThemeResource PrimaryTextBrush}"/>
                        </StackPanel>
                    </Border>

                    <Border
                        Grid.Column="3"
                        Background="{ThemeResource CardBackgroundBrush}"
                        CornerRadius="12"
                        Padding="20"
                        Margin="8,0,0,0">

                        <StackPanel Spacing="6">
                            <TextBlock
                                x:Name="HoursWorkedTitleText"
                                FontSize="14"
                                Foreground="{ThemeResource SecondaryTextBrush}"/>

                            <TextBlock
                                x:Name="HoursWorkedText"
                                FontSize="30"
                                FontWeight="Bold"
                                Foreground="{ThemeResource PrimaryTextBrush}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border
                        Grid.Column="0"
                        Background="{ThemeResource CardBackgroundBrush}"
                        CornerRadius="12"
                        Padding="24"
                        Margin="0,0,8,0">

                        <StackPanel Spacing="16">
                            <TextBlock
                                x:Name="LogsPerInternshipTitleText"
                                FontSize="20"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource PrimaryTextBrush}"/>

                            <ItemsControl
                                x:Name="LogsPerInternshipItemsControl">

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>

                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock
                                                Text="{Binding EmployerName}"
                                                Foreground="{ThemeResource PrimaryTextBrush}"/>

                                            <TextBlock
                                                Grid.Column="1"
                                                Text="{Binding LogCount}"
                                                FontWeight="SemiBold"
                                                Foreground="{ThemeResource SecondaryTextBrush}"/>
                                        </Grid>

                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>

                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border
                        Grid.Column="1"
                        Background="{ThemeResource CardBackgroundBrush}"
                        CornerRadius="12"
                        Padding="24"
                        Margin="8,0,0,0">

                        <StackPanel Spacing="16">
                            <TextBlock
                                x:Name="JournalStatusTitleText"
                                FontSize="20"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource PrimaryTextBrush}"/>

                            <ItemsControl
                                x:Name="JournalStatusItemsControl">

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>

                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock
                                                Text="{Binding Status}"
                                                Foreground="{ThemeResource PrimaryTextBrush}"/>

                                            <TextBlock
                                                Grid.Column="1"
                                                Text="{Binding Count}"
                                                FontWeight="SemiBold"
                                                Foreground="{ThemeResource SecondaryTextBrush}"/>
                                        </Grid>

                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>

                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border
                    Background="{ThemeResource CardBackgroundBrush}"
                    CornerRadius="12"
                    Padding="24">

                    <StackPanel Spacing="16">
                        <TextBlock
                            x:Name="RecentActivityTitleText"
                            FontSize="20"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource PrimaryTextBrush}"/>

                        <ItemsControl
                            x:Name="RecentActivityItemsControl">

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Spacing="3">
                                            <TextBlock
                                                Text="{Binding Title}"
                                                FontWeight="SemiBold"
                                                Foreground="{ThemeResource PrimaryTextBrush}"/>

                                            <TextBlock
                                                Text="{Binding Description}"
                                                FontSize="13"
                                                Foreground="{ThemeResource SecondaryTextBrush}"/>
                                        </StackPanel>

                                        <TextBlock
                                            Grid.Column="1"
                                            Text="{Binding Date}"
                                            FontSize="13"
                                            Foreground="{ThemeResource SecondaryTextBrush}"/>
                                    </Grid>

                                </DataTemplate>
                            </ItemsControl.ItemTemplate>

                        </ItemsControl>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>