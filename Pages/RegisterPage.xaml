<?xml version="1.0" encoding="utf-8"?>

<Page
    x:Class="InternLog.Pages.RegisterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{ThemeResource AppBackgroundBrush}">

        <Border
            Width="450"
            Padding="40"
            Background="{ThemeResource CardBackgroundBrush}"
            CornerRadius="16"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">

            <StackPanel Spacing="16">

                <!-- TITLE -->
                <TextBlock
                    x:Name="RegisterTitleText"
                    FontSize="30"
                    FontWeight="Bold"
                    Foreground="{ThemeResource PrimaryTextBrush}"/>

                <TextBlock
                    x:Name="RegisterDescriptionText"
                    FontSize="14"
                    Foreground="{ThemeResource SecondaryTextBrush}"
                    TextWrapping="Wrap"
                    Margin="0,0,0,10"/>


                <!-- FIRST NAME -->
                <StackPanel Spacing="6">

                    <TextBlock
                        x:Name="FirstNameLabelText"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource PrimaryTextBrush}"/>

                    <TextBox
                        x:Name="FirstNameTextBox"
                        Background="{ThemeResource InputBackgroundBrush}"
                        Foreground="{ThemeResource InputTextBrush}"
                        BorderBrush="{ThemeResource InputBorderBrush}"
                        BorderThickness="1"/>

                </StackPanel>


                <!-- LAST NAME -->
                <StackPanel Spacing="6">

                    <TextBlock
                        x:Name="LastNameLabelText"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource PrimaryTextBrush}"/>

                    <TextBox
                        x:Name="LastNameTextBox"
                        Background="{ThemeResource InputBackgroundBrush}"
                        Foreground="{ThemeResource InputTextBrush}"
                        BorderBrush="{ThemeResource InputBorderBrush}"
                        BorderThickness="1"/>

                </StackPanel>


                <!-- EMAIL -->
                <StackPanel Spacing="6">

                    <TextBlock
                        x:Name="EmailLabelText"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource PrimaryTextBrush}"/>

                    <TextBox
                        x:Name="EmailTextBox"
                        Background="{ThemeResource InputBackgroundBrush}"
                        Foreground="{ThemeResource InputTextBrush}"
                        BorderBrush="{ThemeResource InputBorderBrush}"
                        BorderThickness="1"/>

                </StackPanel>


                <!-- PASSWORD -->
                <StackPanel Spacing="6">

                    <TextBlock
                        x:Name="PasswordLabelText"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource PrimaryTextBrush}"/>

                    <PasswordBox
                        x:Name="PasswordBox"
                        Background="{ThemeResource InputBackgroundBrush}"
                        Foreground="{ThemeResource InputTextBrush}"
                        BorderBrush="{ThemeResource InputBorderBrush}"
                        BorderThickness="1"/>

                </StackPanel>


                <!-- CONFIRM PASSWORD -->
                <StackPanel Spacing="6">

                    <TextBlock
                        x:Name="ConfirmPasswordLabelText"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource PrimaryTextBrush}"/>

                    <PasswordBox
                        x:Name="ConfirmPasswordBox"
                        Background="{ThemeResource InputBackgroundBrush}"
                        Foreground="{ThemeResource InputTextBrush}"
                        BorderBrush="{ThemeResource InputBorderBrush}"
                        BorderThickness="1"/>

                </StackPanel>


                <!-- CREATE ACCOUNT BUTTON -->
                <Button
                    x:Name="CreateAccountButton"
                    Height="45"
                    Margin="0,10,0,0"
                    HorizontalAlignment="Stretch"
                    Background="{ThemeResource PrimaryButtonBrush}"
                    Foreground="{ThemeResource PrimaryButtonTextBrush}"
                    BorderThickness="0"
                    Click="CreateAccountButton_Click"/>

            </StackPanel>

        </Border>

    </Grid>

</Page>
