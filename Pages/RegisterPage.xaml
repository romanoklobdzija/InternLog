<?xml version="1.0" encoding="utf-8"?>

<Page
    x:Class="InternLog.Pages.RegisterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="#F5F6F8">

        <Border
            Width="450"
            Padding="40"
            Background="White"
            CornerRadius="16"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">

            <StackPanel Spacing="16">

                <!-- TITLE -->
                <TextBlock
                    Text="Create your account"
                    FontSize="30"
                    FontWeight="Bold"
                    Foreground="#111827"/>

                <TextBlock
                    Text="Create an account to start tracking your internship."
                    FontSize="14"
                    Foreground="#6B7280"
                    TextWrapping="Wrap"
                    Margin="0,0,0,10"/>


                <!-- FIRST NAME -->
                <StackPanel Spacing="6">

                    <TextBlock
                        Text="First name"
                        FontWeight="SemiBold"
                        Foreground="#374151"/>

                    <TextBox
                        x:Name="FirstNameTextBox"
                        PlaceholderText="Enter your first name"
                        Background="White"
                        BorderBrush="#D1D5DB"
                        BorderThickness="1"/>

                </StackPanel>


                <!-- LAST NAME -->
                <StackPanel Spacing="6">

                    <TextBlock
                        Text="Last name"
                        FontWeight="SemiBold"
                        Foreground="#374151"/>

                    <TextBox
                        x:Name="LastNameTextBox"
                        PlaceholderText="Enter your last name"
                        Background="White"
                        BorderBrush="#D1D5DB"
                        BorderThickness="1"/>

                </StackPanel>


                <!-- EMAIL -->
                <StackPanel Spacing="6">

                    <TextBlock
                        Text="Email"
                        FontWeight="SemiBold"
                        Foreground="#374151"/>

                    <TextBox
                        x:Name="EmailTextBox"
                        PlaceholderText="Enter your email"
                        Background="White"
                        BorderBrush="#D1D5DB"
                        BorderThickness="1"/>

                </StackPanel>


                <!-- PASSWORD -->
                <StackPanel Spacing="6">

                    <TextBlock
                        Text="Password"
                        FontWeight="SemiBold"
                        Foreground="#374151"/>

                    <PasswordBox
                        x:Name="PasswordBox"
                        PlaceholderText="Enter your password"
                        Background="White"
                        BorderBrush="#D1D5DB"
                        BorderThickness="1"/>

                </StackPanel>


                <!-- CONFIRM PASSWORD -->
                <StackPanel Spacing="6">

                    <TextBlock
                        Text="Confirm password"
                        FontWeight="SemiBold"
                        Foreground="#374151"/>

                    <PasswordBox
                        x:Name="ConfirmPasswordBox"
                        PlaceholderText="Enter your password again"
                        Background="White"
                        BorderBrush="#D1D5DB"
                        BorderThickness="1"/>

                </StackPanel>


                <!-- CREATE ACCOUNT BUTTON -->
                <Button
                    x:Name="CreateAccountButton"
                    Content="Create account"
                    Height="45"
                    Margin="0,10,0,0"
                    HorizontalAlignment="Stretch"
                    Background="#2563EB"
                    Foreground="White"
                    BorderThickness="0"
                    Click="CreateAccountButton_Click"/>

            </StackPanel>

        </Border>

    </Grid>

</Page>