<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="InternLog.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{ThemeResource AppBackgroundBrush}">
        <ScrollViewer
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled">

            <StackPanel
                Margin="40"
                Spacing="24"
                MaxWidth="900"
                HorizontalAlignment="Center">

                <StackPanel Spacing="6">
                    <TextBlock
                        x:Name="SettingsTitleText"
                        FontSize="32"
                        FontWeight="Bold"
                        Foreground="{ThemeResource PrimaryTextBrush}"/>

                    <TextBlock
                        x:Name="SettingsDescriptionText"
                        FontSize="16"
                        Foreground="{ThemeResource SecondaryTextBrush}"/>
                </StackPanel>

                <Border
                    Background="{ThemeResource CardBackgroundBrush}"
                    CornerRadius="12"
                    Padding="24">

                    <StackPanel Spacing="18">
                        <StackPanel Spacing="4">
                            <TextBlock
                                x:Name="AppearanceTitleText"
                                FontSize="20"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource PrimaryTextBrush}"/>

                            <TextBlock
                                x:Name="AppearanceDescriptionText"
                                FontSize="14"
                                Foreground="{ThemeResource SecondaryTextBrush}"/>
                        </StackPanel>

                        <ComboBox
                            x:Name="AppearanceComboBox"
                            SelectionChanged="AppearanceComboBox_SelectionChanged"
                            Width="300"
                            HorizontalAlignment="Left">

                            <ComboBoxItem
                                x:Name="LightItem"
                                Content="Light"
                                Tag="Light"/>

                            <ComboBoxItem
                                x:Name="DarkItem"
                                Content="Dark"
                                Tag="Dark"/>

                        </ComboBox>
                    </StackPanel>
                </Border>

                <Border
                    Background="{ThemeResource CardBackgroundBrush}"
                    CornerRadius="12"
                    Padding="24">

                    <StackPanel Spacing="18">
                        <StackPanel Spacing="4">
                            <TextBlock
                                x:Name="NotificationsTitleText"
                                FontSize="20"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource PrimaryTextBrush}"/>

                            <TextBlock
                                x:Name="NotificationsDescriptionText"
                                FontSize="14"
                                Foreground="{ThemeResource SecondaryTextBrush}"/>
                        </StackPanel>

                        <ToggleSwitch
                            x:Name="NotificationsToggle"
                            Toggled="NotificationsToggle_Toggled"
                            Foreground="{ThemeResource PrimaryTextBrush}"/>
                    </StackPanel>
                </Border>

                <Border
                    Background="{ThemeResource CardBackgroundBrush}"
                    CornerRadius="12"
                    Padding="24">

                    <StackPanel Spacing="18">
                        <StackPanel Spacing="4">
                            <TextBlock
                                x:Name="LanguageTitleText"
                                FontSize="20"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource PrimaryTextBrush}"/>

                            <TextBlock
                                x:Name="LanguageDescriptionText"
                                FontSize="14"
                                Foreground="{ThemeResource SecondaryTextBrush}"/>
                        </StackPanel>

                        <ComboBox
                            x:Name="LanguageComboBox"
                            SelectionChanged="LanguageComboBox_SelectionChanged"
                            Width="300"
                            HorizontalAlignment="Left">

                            <ComboBoxItem
                                x:Name="EnglishItem"
                                Content="English"
                                Tag="English"/>

                            <ComboBoxItem
                                x:Name="CroatianItem"
                                Content="Hrvatski"
                                Tag="Hrvatski"/>

                        </ComboBox>
                    </StackPanel>
                </Border>

                <Border
                    Background="{ThemeResource CardBackgroundBrush}"
                    CornerRadius="12"
                    Padding="24">

                    <StackPanel Spacing="12">
                        <TextBlock
                            x:Name="AboutTitleText"
                            FontSize="20"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource PrimaryTextBrush}"/>

                        <TextBlock
                            x:Name="AboutDescriptionText"
                            TextWrapping="Wrap"
                            FontSize="14"
                            Foreground="{ThemeResource SecondaryTextBrush}"/>

                        <TextBlock
                            Text="InternLog"
                            FontSize="17"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource PrimaryTextBrush}"/>

                        <TextBlock
                            Text="Version 1.0.0"
                            FontSize="14"
                            Foreground="{ThemeResource SecondaryTextBrush}"/>
                    </StackPanel>
                </Border>

                <TextBlock
                    x:Name="SettingsSavedText"
                    FontSize="14"
                    Foreground="#16A34A"
                    HorizontalAlignment="Right"
                    Visibility="Collapsed"/>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
