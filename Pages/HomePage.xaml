<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="InternLog.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{ThemeResource AppBackgroundBrush}">
        <ScrollViewer
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">

            <StackPanel
                Margin="40"
                Spacing="24">

                <StackPanel Spacing="6">

                    <TextBlock
                        x:Name="HomeTitleText"
                        FontSize="32"
                        FontWeight="Bold"
                        Foreground="{ThemeResource PrimaryTextBrush}"/>

                    <TextBlock
                        x:Name="HomeDescriptionText"
                        FontSize="16"
                        Foreground="{ThemeResource SecondaryTextBrush}"/>

                </StackPanel>

                <ItemsControl
                    x:Name="InternshipsItemsControl">

                    <ItemsControl.ItemTemplate>

                        <DataTemplate>

                            <Border
                                Background="{ThemeResource CardBackgroundBrush}"
                                CornerRadius="12"
                                Padding="24"
                                Margin="0,0,0,12">

                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel
                                        Spacing="8">

                                        <TextBlock
                                            Text="{Binding Employer.Name}"
                                            FontSize="22"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource PrimaryTextBrush}"/>

                                        <TextBlock
                                            Text="{Binding StartDate}"
                                            FontSize="14"
                                            Foreground="{ThemeResource SecondaryTextBrush}"/>

                                        <TextBlock
                                            Text="{Binding EndDate}"
                                            FontSize="14"
                                            Foreground="{ThemeResource SecondaryTextBrush}"/>

                                    </StackPanel>

                                    <StackPanel
                                        Grid.Column="1"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Spacing="12">

                                        <Border
                                            Background="#F1E8FF"
                                            CornerRadius="8"
                                            Padding="12,6">

                                            <TextBlock
                                                Text="{Binding DisplayStatus}"
                                                Foreground="#7C3AED"
                                                FontWeight="SemiBold"/>

                                        </Border>

                                        <Button
                                            Tag="{Binding Id}"
                                            Click="ViewInternshipButton_Click"
                                            Loaded="ViewInternshipButton_Loaded"
                                            HorizontalAlignment="Left"
                                            Padding="18,9"
                                            MinWidth="150"
                                            Background="{ThemeResource PrimaryButtonBrush}"
                                            BorderThickness="0">

                                        </Button>

                                    </StackPanel>

                                </Grid>

                            </Border>

                        </DataTemplate>

                    </ItemsControl.ItemTemplate>

                </ItemsControl>

                <StackPanel
                    x:Name="EmptyStatePanel"
                    HorizontalAlignment="Center"
                    Spacing="8"
                    Visibility="Collapsed">

                    <TextBlock
                        x:Name="EmptyStateTitleText"
                        FontSize="22"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource PrimaryTextBrush}"
                        HorizontalAlignment="Center"/>

                    <TextBlock
                        x:Name="EmptyStateDescriptionText"
                        FontSize="15"
                        Foreground="{ThemeResource SecondaryTextBrush}"
                        HorizontalAlignment="Center"/>

                </StackPanel>

            </StackPanel>

        </ScrollViewer>
    </Grid>

</Page>
