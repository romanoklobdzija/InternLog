<?xml version="1.0" encoding="utf-8"?>

<Page
    x:Class="InternLog.Pages.EmployerDetailsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>

        <Grid
            Padding="40"
            Background="#F5F6F8">

            <StackPanel
                Spacing="24"
                MaxWidth="1100"
                HorizontalAlignment="Center">

                <!-- BACK -->
                <Button
                    x:Name="BackButton"
                    Content="←  Back to Employers"
                    Click="BackButton_Click"
                    HorizontalAlignment="Left"
                    Background="Transparent"
                    Foreground="#4B5563"
                    BorderThickness="0"
                    FontSize="14"/>


                <!-- HERO -->
                <Border
                    Background="#111827"
                    CornerRadius="18"
                    Padding="36">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>


                        <!-- COMPANY INFORMATION -->
                        <StackPanel
                            Grid.Column="0"
                            Spacing="12">

                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="12">

                                <!-- COMPANY INITIAL -->
                                <Border
                                    Width="56"
                                    Height="56"
                                    CornerRadius="14"
                                    Background="#2563EB">

                                    <TextBlock
                                        x:Name="CompanyInitial"
                                        Text="K"
                                        FontSize="28"
                                        FontWeight="Bold"
                                        Foreground="White"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"/>

                                </Border>


                                <StackPanel
                                    VerticalAlignment="Center">

                                    <TextBlock
                                        x:Name="CompanyNameText"
                                        Text="Konto d.o.o."
                                        FontSize="28"
                                        FontWeight="Bold"
                                        Foreground="White"/>

                                    <TextBlock
                                        x:Name="IndustryText"
                                        Text="Software Development"
                                        FontSize="14"
                                        Foreground="#CBD5E1"/>

                                </StackPanel>

                            </StackPanel>


                            <TextBlock
                                x:Name="LocationText"
                                Text="Požega"
                                FontSize="14"
                                Foreground="#CBD5E1"
                                Margin="68,0,0,0"/>

                        </StackPanel>


                        <!-- STATUS + RESERVE -->
                        <StackPanel
                            Grid.Column="1"
                            Spacing="12"
                            HorizontalAlignment="Right">

                            <!-- STATUS -->
                            <Border
                                Background="#DCFCE7"
                                CornerRadius="20"
                                Padding="14,8"
                                HorizontalAlignment="Right">

                                <StackPanel
                                    Orientation="Horizontal"
                                    Spacing="8">

                                    <Ellipse
                                        Width="9"
                                        Height="9"
                                        Fill="#16A34A"
                                        VerticalAlignment="Center"/>

                                    <TextBlock
                                        Text="Internship open"
                                        Foreground="#166534"
                                        FontWeight="SemiBold"
                                        FontSize="13"/>

                                </StackPanel>

                            </Border>


                            <!-- RESERVE BUTTON -->
                            <Button
                                x:Name="ReserveButton"
                                Content="Reserve internship"
                                Click="ReserveButton_Click"
                                HorizontalAlignment="Right"
                                Background="#2563EB"
                                Foreground="White"
                                BorderThickness="0"
                                Padding="20,11"
                                FontWeight="SemiBold"
                                FontSize="14"/>

                        </StackPanel>

                    </Grid>

                </Border>


                <!-- OVERVIEW TITLE -->
                <TextBlock
                    Text="Internship overview"
                    FontSize="22"
                    FontWeight="SemiBold"
                    Foreground="#111827"
                    Margin="4,8,0,0"/>


                <!-- STAT CARDS -->
                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>


                    <!-- POSITIONS -->
                    <Border
                        Grid.Column="0"
                        Background="White"
                        CornerRadius="14"
                        Padding="24"
                        Margin="0,0,8,0">

                        <StackPanel Spacing="5">

                            <TextBlock
                                Text="AVAILABLE POSITIONS"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="#6B7280"/>

                            <TextBlock
                                x:Name="PositionsText"
                                Text="3"
                                FontSize="27"
                                FontWeight="Bold"
                                Foreground="#111827"/>

                            <TextBlock
                                Text="students can be accepted"
                                FontSize="13"
                                Foreground="#6B7280"/>

                        </StackPanel>

                    </Border>


                    <!-- LOCATION -->
                    <Border
                        Grid.Column="1"
                        Background="White"
                        CornerRadius="14"
                        Padding="24"
                        Margin="8,0">

                        <StackPanel Spacing="5">

                            <TextBlock
                                Text="LOCATION"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="#6B7280"/>

                            <TextBlock
                                x:Name="LocationCardText"
                                Text="Požega"
                                FontSize="22"
                                FontWeight="Bold"
                                Foreground="#111827"/>

                            <TextBlock
                                Text="Internship location"
                                FontSize="13"
                                Foreground="#6B7280"/>

                        </StackPanel>

                    </Border>


                    <!-- INDUSTRY -->
                    <Border
                        Grid.Column="2"
                        Background="White"
                        CornerRadius="14"
                        Padding="24"
                        Margin="8,0,0,0">

                        <StackPanel Spacing="5">

                            <TextBlock
                                Text="INDUSTRY"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="#6B7280"/>

                            <TextBlock
                                x:Name="IndustryCardText"
                                Text="Software"
                                FontSize="20"
                                FontWeight="Bold"
                                Foreground="#111827"
                                TextWrapping="Wrap"/>

                            <TextBlock
                                Text="Field of work"
                                FontSize="13"
                                Foreground="#6B7280"/>

                        </StackPanel>

                    </Border>

                </Grid>


                <!-- MAIN CONTENT -->
                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>


                    <!-- ABOUT -->
                    <Border
                        Grid.Column="0"
                        Background="White"
                        CornerRadius="14"
                        Padding="28"
                        Margin="0,0,8,0">

                        <StackPanel Spacing="14">

                            <TextBlock
                                Text="About the employer"
                                FontSize="20"
                                FontWeight="SemiBold"
                                Foreground="#111827"/>

                            <TextBlock
                                x:Name="DescriptionText"
                                Text="Company description..."
                                FontSize="14"
                                Foreground="#6B7280"
                                TextWrapping="Wrap"
                                LineHeight="23"/>

                        </StackPanel>

                    </Border>


                    <!-- INTERNSHIP EXPERIENCE -->
                    <Border
                        Grid.Column="1"
                        Background="White"
                        CornerRadius="14"
                        Padding="28"
                        Margin="8,0,0,0">

                        <StackPanel Spacing="14">

                            <TextBlock
                                Text="Internship experience"
                                FontSize="20"
                                FontWeight="SemiBold"
                                Foreground="#111827"/>

                            <TextBlock
                                Text="What you can expect during your internship:"
                                FontSize="14"
                                Foreground="#6B7280"/>

                            <TextBlock
                                x:Name="TasksText"
                                Text="Software development and testing"
                                FontSize="14"
                                Foreground="#374151"
                                TextWrapping="Wrap"
                                LineHeight="23"/>

                        </StackPanel>

                    </Border>

                </Grid>


                <!-- BOTTOM SECTION -->
                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>


                    <!-- CONTACT -->
                    <Border
                        Grid.Column="0"
                        Background="White"
                        CornerRadius="14"
                        Padding="28"
                        Margin="0,0,8,0">

                        <StackPanel Spacing="12">

                            <TextBlock
                                Text="Contact"
                                FontSize="20"
                                FontWeight="SemiBold"
                                Foreground="#111827"/>

                            <TextBlock
                                x:Name="ContactEmailText"
                                FontSize="14"
                                Foreground="#374151"/>

                            <TextBlock
                                x:Name="ContactPhoneText"
                                FontSize="14"
                                Foreground="#374151"/>

                            <TextBlock
                                x:Name="WebsiteText"
                                FontSize="14"
                                Foreground="#2563EB"/>

                        </StackPanel>

                    </Border>


                    <!-- INTERNSHIP HIGHLIGHTS -->
                    <Border
                        Grid.Column="1"
                        Background="White"
                        CornerRadius="14"
                        Padding="28"
                        Margin="8,0,0,0">

                        <StackPanel Spacing="14">

                            <TextBlock
                                Text="Internship highlights"
                                FontSize="20"
                                FontWeight="SemiBold"
                                Foreground="#111827"/>

                            <TextBlock
                                Text="What makes this opportunity interesting:"
                                FontSize="14"
                                Foreground="#6B7280"/>


                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="10">

                                <Border
                                    Width="30"
                                    Height="30"
                                    CornerRadius="15"
                                    Background="#DBEAFE">

                                    <TextBlock
                                        Text="✓"
                                        Foreground="#2563EB"
                                        FontWeight="Bold"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"/>

                                </Border>

                                <TextBlock
                                    Text="Real-world experience"
                                    FontSize="14"
                                    Foreground="#374151"
                                    VerticalAlignment="Center"/>

                            </StackPanel>


                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="10">

                                <Border
                                    Width="30"
                                    Height="30"
                                    CornerRadius="15"
                                    Background="#DBEAFE">

                                    <TextBlock
                                        Text="✓"
                                        Foreground="#2563EB"
                                        FontWeight="Bold"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"/>

                                </Border>

                                <TextBlock
                                    Text="Work with modern technologies"
                                    FontSize="14"
                                    Foreground="#374151"
                                    VerticalAlignment="Center"/>

                            </StackPanel>


                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="10">

                                <Border
                                    Width="30"
                                    Height="30"
                                    CornerRadius="15"
                                    Background="#DBEAFE">

                                    <TextBlock
                                        Text="✓"
                                        Foreground="#2563EB"
                                        FontWeight="Bold"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"/>

                                </Border>

                                <TextBlock
                                    Text="Build practical skills"
                                    FontSize="14"
                                    Foreground="#374151"
                                    VerticalAlignment="Center"/>

                            </StackPanel>

                        </StackPanel>

                    </Border>

                </Grid>

            </StackPanel>

        </Grid>

    </ScrollViewer>

</Page>