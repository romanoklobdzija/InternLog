<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="InternLog.Pages.EmployerDetailsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <Grid
            Padding="40"
            Background="{ThemeResource AppBackgroundBrush}">
            <StackPanel
                Spacing="24"
                MaxWidth="1100"
                HorizontalAlignment="Center">
                <Button
                    x:Name="BackButton"
                    Click="BackButton_Click"
                    HorizontalAlignment="Left"
                    Background="Transparent"
                    Foreground="{ThemeResource SecondaryTextBrush}"
                    BorderThickness="0"
                    FontSize="14">
                    <TextBlock x:Name="BackButtonText"/>
                </Button>
                <Border
                    Background="#2A2236"
                    CornerRadius="18"
                    Padding="36">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel
                            Grid.Column="0"
                            Spacing="12">
                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="12">
                                <Border
                                    Width="56"
                                    Height="56"
                                    CornerRadius="14"
                                    Background="{ThemeResource PrimaryButtonBrush}">
                                    <TextBlock
                                        x:Name="CompanyInitial"
                                        FontSize="28"
                                        FontWeight="Bold"
                                        Foreground="White"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock
                                        x:Name="CompanyNameText"
                                        FontSize="28"
                                        FontWeight="Bold"
                                        Foreground="White"/>
                                    <TextBlock
                                        x:Name="IndustryText"
                                        FontSize="14"
                                        Foreground="#E0D5E8"/>
                                </StackPanel>
                            </StackPanel>
                            <TextBlock
                                x:Name="LocationText"
                                FontSize="14"
                                Foreground="#E0D5E8"
                                Margin="68,0,0,0"/>
                        </StackPanel>
                        <StackPanel
                            Grid.Column="1"
                            Spacing="12"
                            HorizontalAlignment="Right">
                            <Border
                                Background="#E4F4E5"
                                CornerRadius="20"
                                Padding="14,8"
                                HorizontalAlignment="Right">
                                <StackPanel
                                    Orientation="Horizontal"
                                    Spacing="8">
                                    <Ellipse
                                        Width="9"
                                        Height="9"
                                        Fill="#378A64"
                                        VerticalAlignment="Center"/>
                                    <TextBlock
                                        x:Name="InternshipOpenText"
                                        Foreground="#1F684A"
                                        FontWeight="SemiBold"
                                        FontSize="13"/>
                                </StackPanel>
                            </Border>
                            <Button
                                x:Name="ReserveButton"
                                Click="ReserveButton_Click"
                                HorizontalAlignment="Right"
                                Background="{ThemeResource PrimaryButtonBrush}"
                                Foreground="{ThemeResource PrimaryButtonTextBrush}"
                                BorderThickness="0"
                                Padding="20,11"
                                FontWeight="SemiBold"
                                FontSize="14"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <TextBlock
                    x:Name="OverviewTitleText"
                    FontSize="22"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource PrimaryTextBrush}"
                    Margin="4,8,0,0"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border
                        Grid.Column="0"
                        Background="{ThemeResource CardBackgroundBrush}"
                        CornerRadius="14"
                        Padding="24"
                        Margin="0,0,8,0">
                        <StackPanel Spacing="5">
                            <TextBlock
                                x:Name="AvailablePositionsTitleText"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource SecondaryTextBrush}"/>
                            <TextBlock
                                x:Name="PositionsText"
                                FontSize="27"
                                FontWeight="Bold"
                                Foreground="{ThemeResource PrimaryTextBrush}"/>
                            <TextBlock
                                x:Name="AvailablePositionsDescriptionText"
                                FontSize="13"
                                Foreground="{ThemeResource SecondaryTextBrush}"/>
                        </StackPanel>
                    </Border>
                    <Border
                        Grid.Column="1"
                        Background="{ThemeResource CardBackgroundBrush}"
                        CornerRadius="14"
                        Padding="24"
                        Margin="8,0">
                        <StackPanel Spacing="5">
                            <TextBlock
                                x:Name="LocationTitleText"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource SecondaryTextBrush}"/>
                            <TextBlock
                                x:Name="LocationCardText"
                                FontSize="22"
                                FontWeight="Bold"
                                Foreground="{ThemeResource PrimaryTextBrush}"/>
                            <TextBlock
                                x:Name="LocationDescriptionText"
                                FontSize="13"
                                Foreground="{ThemeResource SecondaryTextBrush}"/>
                        </StackPanel>
                    </Border>
                    <Border
                        Grid.Column="2"
                        Background="{ThemeResource CardBackgroundBrush}"
                        CornerRadius="14"
                        Padding="24"
                        Margin="8,0,0,0">
                        <StackPanel Spacing="5">
                            <TextBlock
                                x:Name="IndustryTitleText"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource SecondaryTextBrush}"/>
                            <TextBlock
                                x:Name="IndustryCardText"
                                FontSize="20"
                                FontWeight="Bold"
                                Foreground="{ThemeResource PrimaryTextBrush}"
                                TextWrapping="Wrap"/>
                            <TextBlock
                                x:Name="IndustryDescriptionText"
                                FontSize="13"
                                Foreground="{ThemeResource SecondaryTextBrush}"/>
                        </StackPanel>
                    </Border>
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border
                        Grid.Column="0"
                        Background="{ThemeResource CardBackgroundBrush}"
                        CornerRadius="14"
                        Padding="28"
                        Margin="0,0,8,0">
                        <StackPanel Spacing="14">
                            <TextBlock
                                x:Name="AboutEmployerTitleText"
                                FontSize="20"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource PrimaryTextBrush}"/>
                            <TextBlock
                                x:Name="DescriptionText"
                                FontSize="14"
                                Foreground="{ThemeResource SecondaryTextBrush}"
                                TextWrapping="Wrap"
                                LineHeight="23"/>
                        </StackPanel>
                    </Border>
                    <Border
                        Grid.Column="1"
                        Background="{ThemeResource CardBackgroundBrush}"
                        CornerRadius="14"
                        Padding="28"
                        Margin="8,0,0,0">
                        <StackPanel Spacing="14">
                            <TextBlock
                                x:Name="InternshipExperienceTitleText"
                                FontSize="20"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource PrimaryTextBrush}"/>
                            <TextBlock
                                x:Name="InternshipExperienceDescriptionText"
                                FontSize="14"
                                Foreground="{ThemeResource SecondaryTextBrush}"/>
                            <TextBlock
                                x:Name="TasksText"
                                FontSize="14"
                                Foreground="{ThemeResource InputTextBrush}"
                                TextWrapping="Wrap"
                                LineHeight="23"/>
                        </StackPanel>
                    </Border>
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border
                        Grid.Column="0"
                        Background="{ThemeResource CardBackgroundBrush}"
                        CornerRadius="14"
                        Padding="28"
                        Margin="0,0,8,0">
                        <StackPanel Spacing="12">
                            <TextBlock
                                x:Name="ContactTitleText"
                                FontSize="20"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource PrimaryTextBrush}"/>
                            <TextBlock
                                x:Name="ContactEmailText"
                                FontSize="14"
                                Foreground="{ThemeResource InputTextBrush}"/>
                            <TextBlock
                                x:Name="ContactPhoneText"
                                FontSize="14"
                                Foreground="{ThemeResource InputTextBrush}"/>
                            <TextBlock
                                x:Name="WebsiteText"
                                FontSize="14"
                                Foreground="#7C3AED"/>
                        </StackPanel>
                    </Border>
                    <Border
                        Grid.Column="1"
                        Background="{ThemeResource CardBackgroundBrush}"
                        CornerRadius="14"
                        Padding="28"
                        Margin="8,0,0,0">
                        <StackPanel Spacing="14">
                            <TextBlock
                                x:Name="InternshipHighlightsTitleText"
                                FontSize="20"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource PrimaryTextBrush}"/>
                            <TextBlock
                                x:Name="InternshipHighlightsDescriptionText"
                                FontSize="14"
                                Foreground="{ThemeResource SecondaryTextBrush}"/>
                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="10">
                                <Border
                                    Width="30"
                                    Height="30"
                                    CornerRadius="15"
                                    Background="#F1E8FF">
                                    <TextBlock
                                        Text="✓"
                                        Foreground="#7C3AED"
                                        FontWeight="Bold"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock
                                    x:Name="RealWorldExperienceText"
                                    FontSize="14"
                                    Foreground="{ThemeResource InputTextBrush}"
                                    VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="10">
                                <Border
                                    Width="30"
                                    Height="30"
                                    CornerRadius="15"
                                    Background="#F1E8FF">
                                    <TextBlock
                                        Text="✓"
                                        Foreground="#7C3AED"
                                        FontWeight="Bold"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock
                                    x:Name="ModernTechnologiesText"
                                    FontSize="14"
                                    Foreground="{ThemeResource InputTextBrush}"
                                    VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="10">
                                <Border
                                    Width="30"
                                    Height="30"
                                    CornerRadius="15"
                                    Background="#F1E8FF">
                                    <TextBlock
                                        Text="✓"
                                        Foreground="#7C3AED"
                                        FontWeight="Bold"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock
                                    x:Name="PracticalSkillsText"
                                    FontSize="14"
                                    Foreground="{ThemeResource InputTextBrush}"
                                    VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
