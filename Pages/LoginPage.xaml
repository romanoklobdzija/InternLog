<?xml version="1.0" encoding="utf-8"?>

<Page
    x:Class="InternLog.Pages.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="#F5F6F8">

        <Border
            Width="450"
            Padding="40"
            Background="White"
            CornerRadius="16"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">

            <StackPanel Spacing="16">

                <!-- TITLE -->
                <TextBlock
                    Text="Welcome back"
                    FontSize="30"
                    FontWeight="Bold"
                    Foreground="#111827"/>

                <TextBlock
                    Text="Log in to continue tracking your internship."
                    FontSize="14"
                    Foreground="#6B7280"
                    TextWrapping="Wrap"
                    Margin="0,0,0,10"/>


                <!-- EMAIL -->
                <StackPanel Spacing="6">

                    <TextBlock
                        Text="Email"
                        FontWeight="SemiBold"
                        Foreground="#374151"/>

                    <TextBox
                        x:Name="EmailTextBox"
                        PlaceholderText="Enter your email"
                        Background="White"
                        BorderBrush="#D1D5DB"
                        BorderThickness="1"/>

                </StackPanel>


                <!-- PASSWORD -->
                <StackPanel Spacing="6">

                    <TextBlock
                        Text="Password"
                        FontWeight="SemiBold"
                        Foreground="#374151"/>

                    <PasswordBox
                        x:Name="PasswordBox"
                        PlaceholderText="Enter your password"
                        Background="White"
                        BorderBrush="#D1D5DB"
                        BorderThickness="1"/>

                </StackPanel>


                <!-- LOGIN BUTTON -->
                <Button
                    x:Name="LoginButton"
                    Content="Log in"
                    Height="45"
                    Margin="0,10,0,0"
                    HorizontalAlignment="Stretch"
                    Background="#2563EB"
                    Foreground="White"
                    BorderThickness="0"
                    Click="LoginButton_Click"/>


                <!-- REGISTER -->
                <Button
                    Content="Create an account"
                    HorizontalAlignment="Center"
                    Background="Transparent"
                    Foreground="#2563EB"
                    BorderThickness="0"
                    Click="RegisterButton_Click"/>

            </StackPanel>

        </Border>

    </Grid>

</Page>