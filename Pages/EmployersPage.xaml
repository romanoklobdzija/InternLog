<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="InternLog.Pages.EmployersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <Grid
            Padding="40"
            Background="{ThemeResource AppBackgroundBrush}">

            <StackPanel Spacing="24">

                <StackPanel Spacing="6">

                    <TextBlock
                        x:Name="EmployersTitleText"
                        FontSize="32"
                        FontWeight="Bold"
                        Foreground="{ThemeResource PrimaryTextBrush}"/>

                    <TextBlock
                        x:Name="EmployersDescriptionText"
                        FontSize="15"
                        Foreground="{ThemeResource SecondaryTextBrush}"/>

                </StackPanel>

                <TextBox
                    x:Name="SearchTextBox"
                    Height="42"
                    Background="{ThemeResource InputBackgroundBrush}"
                    BorderBrush="{ThemeResource InputBorderBrush}"
                    BorderThickness="1"
                    Foreground="{ThemeResource InputTextBrush}"
                    TextChanged="SearchTextBox_TextChanged"/>

                <GridView
                    x:Name="EmployersGridView"
                    IsItemClickEnabled="True"
                    SelectionMode="None"
                    ItemClick="Employer_ItemClick"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch">

                    <GridView.ItemContainerStyle>
                        <Style TargetType="GridViewItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,0,14"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderBrush" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="FocusVisualPrimaryThickness" Value="0"/>
                            <Setter Property="FocusVisualSecondaryThickness" Value="0"/>
                        </Style>
                    </GridView.ItemContainerStyle>

                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsStackPanel Orientation="Vertical"/>
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>

                    <GridView.ItemTemplate>
                        <DataTemplate>

                            <Border
                                Padding="24"
                                Background="{ThemeResource CardBackgroundBrush}"
                                CornerRadius="12"
                                HorizontalAlignment="Stretch">

                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Spacing="8">

                                    <TextBlock
                                        Text="{Binding Name}"
                                        FontSize="20"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource PrimaryTextBrush}"
                                        TextWrapping="Wrap"/>

                                    <TextBlock
                                        Text="{Binding Industry}"
                                        FontSize="14"
                                        Foreground="{ThemeResource SecondaryTextBrush}"/>

                                    <TextBlock
                                        Text="{Binding Location}"
                                        FontSize="13"
                                        Foreground="{ThemeResource SecondaryTextBrush}"/>

                                    <TextBlock
                                        Text="{Binding AvailablePositionsText}"
                                        FontSize="13"
                                        Foreground="{ThemeResource PrimaryTextBrush}"
                                        Margin="0,4,0,0"/>

                                    </StackPanel>

                                    <Button
                                        Grid.Column="1"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Padding="18,9"
                                        MinWidth="150"
                                        Background="{ThemeResource PrimaryButtonBrush}"
                                        BorderThickness="0"
                                        Loaded="ViewDetailsButton_Loaded"
                                        Click="ViewDetailsButton_Click">
                                    </Button>

                                </Grid>

                            </Border>

                        </DataTemplate>
                    </GridView.ItemTemplate>

                </GridView>

            </StackPanel>

        </Grid>
    </ScrollViewer>

</Page>
