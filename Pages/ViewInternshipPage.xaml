<?xml version="1.0" encoding="utf-8"?>

<Page
    x:Class="InternLog.Pages.ViewInternshipPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="#F5F6F8">

        <ScrollViewer
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">

            <StackPanel
                Margin="40"
                Spacing="24">

                <!-- HEADER -->

                <StackPanel Spacing="6">

                    <TextBlock
                        Text="Internship Details"
                        FontSize="32"
                        FontWeight="Bold"
                        Foreground="#111827"/>

                    <TextBlock
                        x:Name="EmployerNameText"
                        FontSize="18"
                        Foreground="#6B7280"/>

                </StackPanel>


                <!-- INTERNSHIP INFORMATION -->

                <Border
                    Background="White"
                    CornerRadius="12"
                    Padding="24">

                    <StackPanel Spacing="20">

                        <TextBlock
                            Text="Internship Information"
                            FontSize="21"
                            FontWeight="SemiBold"
                            Foreground="#111827"/>


                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>


                            <TextBlock
                                Text="Employer"
                                FontWeight="SemiBold"
                                Foreground="#6B7280"/>

                            <TextBlock
                                x:Name="EmployerText"
                                Grid.Column="1"
                                Foreground="#111827"/>


                            <TextBlock
                                Text="Location"
                                Grid.Row="1"
                                FontWeight="SemiBold"
                                Foreground="#6B7280"/>

                            <TextBlock
                                x:Name="LocationText"
                                Grid.Row="1"
                                Grid.Column="1"
                                Foreground="#111827"/>


                            <TextBlock
                                Text="Start date"
                                Grid.Row="2"
                                FontWeight="SemiBold"
                                Foreground="#6B7280"/>

                            <TextBlock
                                x:Name="StartDateText"
                                Grid.Row="2"
                                Grid.Column="1"
                                Foreground="#111827"/>


                            <TextBlock
                                Text="End date"
                                Grid.Row="3"
                                FontWeight="SemiBold"
                                Foreground="#6B7280"/>

                            <TextBlock
                                x:Name="EndDateText"
                                Grid.Row="3"
                                Grid.Column="1"
                                Foreground="#111827"/>

                        </Grid>

                    </StackPanel>

                </Border>


                <!-- STATUS -->

                <Border
                    Background="White"
                    CornerRadius="12"
                    Padding="24">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="5">

                            <TextBlock
                                Text="Internship Status"
                                FontSize="20"
                                FontWeight="SemiBold"
                                Foreground="#111827"/>

                            <TextBlock
                                Text="Current status of your internship."
                                FontSize="14"
                                Foreground="#6B7280"/>

                        </StackPanel>

                        <Border
                            Grid.Column="1"
                            Background="#E8F0FE"
                            CornerRadius="8"
                            Padding="14,7"
                            VerticalAlignment="Center">

                            <TextBlock
                                x:Name="StatusText"
                                Foreground="#2563EB"
                                FontWeight="SemiBold"/>

                        </Border>

                    </Grid>

                </Border>


                <!-- DAILY LOG -->

                <Border
                    Background="White"
                    CornerRadius="12"
                    Padding="24">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="5">

                            <TextBlock
                                Text="Daily Journal"
                                FontSize="20"
                                FontWeight="SemiBold"
                                Foreground="#111827"/>

                            <TextBlock
                                x:Name="JournalStatusText"
                                FontSize="14"
                                Foreground="#6B7280"/>

                        </StackPanel>

                        <Button
                            x:Name="OpenDailyLogButton"
                            Grid.Column="1"
                            Content="Open Daily Log"
                            VerticalAlignment="Center"
                            Click="OpenDailyLogButton_Click"/>

                    </Grid>

                </Border>


                <!-- ACTIONS -->

                <StackPanel
                    Orientation="Horizontal"
                    Spacing="12">

                    <Button
                        x:Name="SubmitJournalButton"
                        Content="Submit Journal for Review"
                        Click="SubmitJournalButton_Click"/>

                    <Button
                        x:Name="CancelInternshipButton"
                        Content="Cancel Internship"
                        Click="CancelInternshipButton_Click"/>

                </StackPanel>

            </StackPanel>

        </ScrollViewer>

    </Grid>

</Page>