<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="InternLog.Pages.ViewInternshipPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{ThemeResource AppBackgroundBrush}">
        <ScrollViewer
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel
                Margin="40"
                Spacing="24">
                <Button
                    x:Name="BackButton"
                    Click="BackButton_Click"
                    HorizontalAlignment="Left"
                    Background="Transparent"
                    Foreground="{ThemeResource SecondaryTextBrush}"
                    BorderThickness="0"
                    FontSize="14">
                    <TextBlock x:Name="BackButtonText" />
                </Button>
                <StackPanel Spacing="6">
                    <TextBlock
                        x:Name="InternshipDetailsTitleText"
                        FontSize="32"
                        FontWeight="Bold"
                        Foreground="{ThemeResource PrimaryTextBrush}"/>
                    <TextBlock
                        x:Name="EmployerNameText"
                        FontSize="18"
                        Foreground="{ThemeResource SecondaryTextBrush}"/>
                </StackPanel>
                <Border
                    Background="{ThemeResource CardBackgroundBrush}"
                    CornerRadius="12"
                    Padding="24">
                    <StackPanel Spacing="20">
                        <TextBlock
                            x:Name="InternshipInformationTitleText"
                            FontSize="21"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource PrimaryTextBrush}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock
                                x:Name="EmployerLabelText"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource SecondaryTextBrush}"/>
                            <TextBlock
                                x:Name="EmployerText"
                                Grid.Column="1"
                                Foreground="{ThemeResource PrimaryTextBrush}"/>
                            <TextBlock
                                x:Name="LocationLabelText"
                                Grid.Row="1"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource SecondaryTextBrush}"/>
                            <TextBlock
                                x:Name="LocationText"
                                Grid.Row="1"
                                Grid.Column="1"
                                Foreground="{ThemeResource PrimaryTextBrush}"/>
                            <TextBlock
                                x:Name="StartDateLabelText"
                                Grid.Row="2"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource SecondaryTextBrush}"/>
                            <TextBlock
                                x:Name="StartDateText"
                                Grid.Row="2"
                                Grid.Column="1"
                                Foreground="{ThemeResource PrimaryTextBrush}"/>
                            <TextBlock
                                x:Name="EndDateLabelText"
                                Grid.Row="3"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource SecondaryTextBrush}"/>
                            <TextBlock
                                x:Name="EndDateText"
                                Grid.Row="3"
                                Grid.Column="1"
                                Foreground="{ThemeResource PrimaryTextBrush}"/>
                        </Grid>
                    </StackPanel>
                </Border>
                <Border
                    Background="{ThemeResource CardBackgroundBrush}"
                    CornerRadius="12"
                    Padding="24">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="5">
                            <TextBlock
                                x:Name="InternshipStatusTitleText"
                                FontSize="20"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource PrimaryTextBrush}"/>
                            <TextBlock
                                x:Name="InternshipStatusDescriptionText"
                                FontSize="14"
                                Foreground="{ThemeResource SecondaryTextBrush}"/>
                        </StackPanel>
                        <Border
                            Grid.Column="1"
                            Background="#F1E8FF"
                            CornerRadius="8"
                            Padding="14,7"
                            VerticalAlignment="Center">
                            <TextBlock
                                x:Name="StatusText"
                                Foreground="#7C3AED"
                                FontWeight="SemiBold"/>
                        </Border>
                    </Grid>
                </Border>
                <Border
                    Background="{ThemeResource CardBackgroundBrush}"
                    CornerRadius="12"
                    Padding="24">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="5">
                            <TextBlock
                                x:Name="DailyJournalTitleText"
                                FontSize="20"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource PrimaryTextBrush}"/>
                            <TextBlock
                                x:Name="JournalStatusText"
                                FontSize="14"
                                Foreground="{ThemeResource SecondaryTextBrush}"/>
                        </StackPanel>
                        <Button
                            x:Name="OpenDailyLogButton"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Click="OpenDailyLogButton_Click"/>
                    </Grid>
                </Border>
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="12">
                    <Button
                        x:Name="SubmitJournalButton"
                        Click="SubmitJournalButton_Click"/>
                    <Button
                        x:Name="CancelInternshipButton"
                        Click="CancelInternshipButton_Click"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
