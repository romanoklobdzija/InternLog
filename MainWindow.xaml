<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="InternLog.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:InternLog"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="InternLog">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid Background="#F5F6F8">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR -->
        <Border
        Grid.Column="0"
        Background="#4272f5"
        Padding="20">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- LOGO -->
                <StackPanel Spacing="4">
                    <TextBlock
                    Text="InternLog"
                    FontSize="26"
                    FontWeight="Bold"
                    Foreground="White"/>

                    <TextBlock
                    Text="Internship tracker"
                    FontSize="13"
                    Foreground="#9CA3AF"/>
                </StackPanel>


                <!-- NAVIGATION -->
                <StackPanel
                Grid.Row="1"
                Margin="0,40,0,0"
                Spacing="8">

                    <Button
                    Content="Dashboard"
                    HorizontalContentAlignment="Left"
                    Height="44"/>

                    <Button
                    Content="Daily Log"
                    HorizontalContentAlignment="Left"
                    Height="44"/>

                    <Button
                    Content="Calendar"
                    HorizontalContentAlignment="Left"
                    Height="44"/>

                    <Button
                    Content="Statistics"
                    HorizontalContentAlignment="Left"
                    Height="44"/>

                    <Button
                    Content="Profile"
                    HorizontalContentAlignment="Left"
                    Height="44"/>

                </StackPanel>


                <!-- BOTTOM -->
                <TextBlock
                Grid.Row="2"
                Text="InternLog 2026"
                Foreground="#9CA3AF"
                FontSize="12"/>

            </Grid>

        </Border>


        <!-- MAIN CONTENT -->
        <Grid
        Grid.Column="1"
        Padding="40">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>


            <!-- HEADER -->
            <StackPanel Spacing="6">

                <TextBlock
                Text="Dashboard"
                FontSize="32"
                FontWeight="Bold"
                Foreground="#111827"/>

                <TextBlock
                Text="Welcome back. Here's an overview of your internship."
                FontSize="15"
                Foreground="#6B7280"/>

            </StackPanel>


            <!-- STAT CARDS -->
            <Grid
            Grid.Row="1"
            Margin="0,30,0,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>


                <!-- HOURS -->
                <Border
                Grid.Column="0"
                Background="White"
                CornerRadius="12"
                Padding="24"
                Margin="0,0,10,0">

                    <StackPanel Spacing="8">

                        <TextBlock
                        Text="Total Hours"
                        FontSize="14"
                        Foreground="#6B7280"/>

                        <TextBlock
                        Text="56 h"
                        FontSize="28"
                        FontWeight="Bold"
                        Foreground="#111827"/>

                    </StackPanel>

                </Border>


                <!-- DAYS -->
                <Border
                Grid.Column="1"
                Background="White"
                CornerRadius="12"
                Padding="24"
                Margin="10,0,10,0">

                    <StackPanel Spacing="8">

                        <TextBlock
                        Text="Days Completed"
                        FontSize="14"
                        Foreground="#6B7280"/>

                        <TextBlock
                        Text="7"
                        FontSize="28"
                        FontWeight="Bold"
                        Foreground="#111827"/>

                    </StackPanel>

                </Border>


                <!-- PROGRESS -->
                <Border
                Grid.Column="2"
                Background="White"
                CornerRadius="12"
                Padding="24"
                Margin="10,0,0,0">

                    <StackPanel Spacing="8">

                        <TextBlock
                        Text="Progress"
                        FontSize="14"
                        Foreground="#6B7280"/>

                        <TextBlock
                        Text="35%"
                        FontSize="28"
                        FontWeight="Bold"
                        Foreground="#111827"/>

                    </StackPanel>

                </Border>

            </Grid>


            <!-- RECENT ACTIVITY -->
            <Border
            Grid.Row="2"
            Background="White"
            CornerRadius="12"
            Padding="24"
            Margin="0,30,0,0">

                <StackPanel Spacing="15">

                    <TextBlock
                    Text="Recent Activity"
                    FontSize="20"
                    FontWeight="SemiBold"
                    Foreground="#111827"/>

                    <TextBlock
                    Text="No recent entries."
                    FontSize="14"
                    Foreground="#6B7280"/>

                </StackPanel>

            </Border>

        </Grid>

    </Grid>
</Window>
