<Window
    x:Class="InternLog.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="InternLog">

    <Grid>

        <!-- AUTHENTICATION AREA -->
        <Frame
            x:Name="AuthenticationFrame"
            Visibility="Visible"/>


        <!-- MAIN APPLICATION -->
        <Grid
            x:Name="ApplicationView"
            Visibility="Collapsed"
            Background="#F5F6F8">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>


            <!-- SIDEBAR -->
            <Border
                Grid.Column="0"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="0,0,1,0">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>


                    <!-- HEADER -->
                    <StackPanel
                        Grid.Row="0"
                        Margin="24,30,24,30">

                        <TextBlock
                            Text="InternLog"
                            FontSize="26"
                            FontWeight="Bold"
                            Foreground="#111827"/>

                        <TextBlock
                            Text="Internship tracker"
                            FontSize="12"
                            Foreground="#6B7280"
                            Margin="0,4,0,0"/>

                    </StackPanel>


                    <!-- NAVIGATION -->
                    <StackPanel
                        Grid.Row="1"
                        Spacing="8"
                        Margin="12,0">

                        <!-- HOME -->
                        <Button
                            Content="Home"
                            Height="44"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Padding="16,0"
                            Background="#F3F4F6"
                            Foreground="#111827"
                            BorderThickness="0"
                            Click="HomeButton_Click"/>


                        <!-- EMPLOYERS -->
                        <Button
                            Content="Employers"
                            Height="44"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Padding="16,0"
                            Background="#F3F4F6"
                            Foreground="#111827"
                            BorderThickness="0"
                            Click="EmployersButton_Click"/>


                        <!-- DAILY LOG -->
                        <Button
                            Content="Daily Log"
                            Height="44"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Padding="16,0"
                            Background="#F3F4F6"
                            Foreground="#111827"
                            BorderThickness="0"
                            Click="DailyLogButton_Click"/>


                        <!-- DASHBOARD -->
                        <Button
                            Content="Dashboard"
                            Height="44"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Padding="16,0"
                            Background="#F3F4F6"
                            Foreground="#111827"
                            BorderThickness="0"
                            Click="DashboardButton_Click"/>


                        <!-- PROFILE -->
                        <Button
                            Content="Profile"
                            Height="44"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Padding="16,0"
                            Background="#F3F4F6"
                            Foreground="#111827"
                            BorderThickness="0"
                            Click="ProfileButton_Click"/>



                    </StackPanel>


                    <!-- BOTTOM NAVIGATION -->
                    <StackPanel
    Grid.Row="2"
    Spacing="8"
    Margin="12,12,12,24">

                        <!-- SETTINGS -->
                        <Button
                            Content="Settings"
                            Height="44"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Padding="16,0"
                            Background="#F3F4F6"
                            Foreground="#111827"
                            BorderThickness="0"
                            Click="SettingsButton_Click"/>

                        <!-- LOGOUT -->
                        <Button
                            Content="Log out"
                            Height="44"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Padding="16,0"
                            Background="#FEE2E2"
                            Foreground="#B91C1C"
                            BorderThickness="0"
                            Click="LogoutButton_Click"/>

                    </StackPanel>


                </Grid>

            </Border>


            <!-- PAGE CONTENT -->
            <Frame
                x:Name="ContentFrame"
                Grid.Column="1"/>

        </Grid>

    </Grid>

</Window>