<Window
    x:Class="InternLog.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="InternLog">

    <Grid>
        <Frame
            x:Name="AuthenticationFrame"
            Visibility="Visible"/>

        <Grid
            x:Name="ApplicationView"
            Visibility="Collapsed"
            Background="{ThemeResource AppBackgroundBrush}">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                Background="{ThemeResource NavigationBackgroundBrush}"
                BorderBrush="{ThemeResource BorderBrush}"
                BorderThickness="0,0,1,0">

                <Border.Resources>
                    <ResourceDictionary>
                        <ResourceDictionary.ThemeDictionaries>
                            <ResourceDictionary x:Key="Light">
                                <SolidColorBrush
                                    x:Key="ButtonBackgroundPointerOver"
                                    Color="#EEE7F7"/>
                                <SolidColorBrush
                                    x:Key="ButtonBorderBrushPointerOver"
                                    Color="#D8C9EA"/>
                                <SolidColorBrush
                                    x:Key="ButtonForegroundPointerOver"
                                    Color="#241B32"/>
                                <SolidColorBrush
                                    x:Key="ButtonBackgroundPressed"
                                    Color="#DDD1EE"/>
                                <SolidColorBrush
                                    x:Key="ButtonBorderBrushPressed"
                                    Color="#C3AEDC"/>
                                <SolidColorBrush
                                    x:Key="ButtonForegroundPressed"
                                    Color="#241B32"/>
                            </ResourceDictionary>

                            <ResourceDictionary x:Key="Dark">
                                <SolidColorBrush
                                    x:Key="ButtonBackgroundPointerOver"
                                    Color="#E7DDF1"/>
                                <SolidColorBrush
                                    x:Key="ButtonBorderBrushPointerOver"
                                    Color="#D5C4E5"/>
                                <SolidColorBrush
                                    x:Key="ButtonForegroundPointerOver"
                                    Color="#241B32"/>
                                <SolidColorBrush
                                    x:Key="ButtonBackgroundPressed"
                                    Color="#D4C4E4"/>
                                <SolidColorBrush
                                    x:Key="ButtonBorderBrushPressed"
                                    Color="#C1ABD9"/>
                                <SolidColorBrush
                                    x:Key="ButtonForegroundPressed"
                                    Color="#241B32"/>
                            </ResourceDictionary>
                        </ResourceDictionary.ThemeDictionaries>
                    </ResourceDictionary>
                </Border.Resources>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel
                        Grid.Row="0"
                        Margin="24,30,24,30">

                        <TextBlock
                            Text="InternLog"
                            FontSize="26"
                            FontWeight="Bold"
                            Foreground="{ThemeResource NavigationButtonTextBrush}"/>

                        <TextBlock
                            x:Name="AppSubtitleText"
                            FontSize="12"
                            Foreground="{ThemeResource NavigationButtonTextBrush}"
                            Margin="0,4,0,0"/>

                    </StackPanel>

                    <StackPanel
                        Grid.Row="1"
                        Spacing="8"
                        Margin="12,0">

                        <Button
                            x:Name="HomeButton"
                            Height="44"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Padding="16,0"
                            Background="{ThemeResource NavigationButtonBrush}"
                            Foreground="{ThemeResource NavigationButtonTextBrush}"
                            BorderThickness="0"
                            Click="HomeButton_Click"/>

                        <Button
                            x:Name="EmployersButton"
                            Height="44"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Padding="16,0"
                            Background="{ThemeResource NavigationButtonBrush}"
                            Foreground="{ThemeResource NavigationButtonTextBrush}"
                            BorderThickness="0"
                            Click="EmployersButton_Click"/>

                        <Button
                            x:Name="DailyLogButton"
                            Height="44"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Padding="16,0"
                            Background="{ThemeResource NavigationButtonBrush}"
                            Foreground="{ThemeResource NavigationButtonTextBrush}"
                            BorderThickness="0"
                            Click="DailyLogButton_Click"/>

                        <Button
                            x:Name="DashboardButton"
                            Height="44"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Padding="16,0"
                            Background="{ThemeResource NavigationButtonBrush}"
                            Foreground="{ThemeResource NavigationButtonTextBrush}"
                            BorderThickness="0"
                            Click="DashboardButton_Click"/>

                        <Button
                            x:Name="ProfileButton"
                            Height="44"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Padding="16,0"
                            Background="{ThemeResource NavigationButtonBrush}"
                            Foreground="{ThemeResource NavigationButtonTextBrush}"
                            BorderThickness="0"
                            Click="ProfileButton_Click"/>

                    </StackPanel>

                    <StackPanel
                        Grid.Row="2"
                        Spacing="8"
                        Margin="12,12,12,24">

                        <Button
                            x:Name="SettingsButton"
                            Height="44"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Padding="16,0"
                            Background="{ThemeResource NavigationButtonBrush}"
                            Foreground="{ThemeResource NavigationButtonTextBrush}"
                            BorderThickness="0"
                            Click="SettingsButton_Click"/>

                        <Button
                            x:Name="LogoutButton"
                            Height="44"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Padding="16,0"
                            Background="{ThemeResource NavigationButtonBrush}"
                            Foreground="{ThemeResource NavigationButtonTextBrush}"
                            BorderThickness="0"
                            Click="LogoutButton_Click"/>

                    </StackPanel>

                </Grid>

            </Border>

            <Frame
                x:Name="ContentFrame"
                Grid.Column="1"/>

        </Grid>

    </Grid>

</Window>
